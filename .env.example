# Path to your Obsidian vault root directory
VAULT_PATH=/path/to/your/vault

# Static bearer token for Claude Code remote access
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=

# HTTP server port (used with --transport http)
PORT=3100

# Default agent name for frontmatter attribution
AGENT_NAME_DEFAULT=claude

# Server URL (used for OAuth metadata endpoints)
# Set to your Tailscale Funnel URL in production
# get your tailscale URL via:
#    tailscale whois $(tailscale ip -4)
SERVER_URL=http://localhost:3100

# vault_move rewrites links to a moved note, but never edits notes matching these globs
# (comma-separated, vault-relative, * and ** supported); it reports them instead.
# An empty value protects nothing. Default shown:
# LINK_REWRITE_SKIP=10-identity/**,60-daily/**,**/decisions.md,00-meta/agent-comms/**

# ── Auth hardening ──
# REQUIRED for --transport http. Generate with: npm run build && node scripts/totp-setup.mjs
CONSENT_TOTP_SECRET=
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# OAUTH_ALLOW_LOOPBACK=true
# OAUTH_MAX_CLIENTS=25
# CORS_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# REQUEST_LOG_PATH=/Users/you/logs/obsidian-mcp-requests.jsonl
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
